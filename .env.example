NEXORA_HOST=127.0.0.1
NEXORA_PORT=8787
NEXORA_WORKSPACE=./workspace
NEXORA_DATA=./data
NEXORA_APPROVAL_MODE=ask
NEXORA_TERMINAL_MODE=ask
NEXORA_PROVIDER_MODE=manual
NEXORA_PROVIDER=litert
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
NEXORA_LITERT_BIN=litert-lm
NEXORA_LITERT_COMMAND=litert-lm run --from-huggingface-repo=litert-community/gemma-4-E2B-it-litert-lm gemma-4-E2B-it.litertlm --prompt {prompt}
NEXORA_LITERT_MODEL_REPO=litert-community/gemma-4-E2B-it-litert-lm
NEXORA_LITERT_MODEL_FILE=gemma-4-E2B-it.litertlm
NEXORA_LITERT_BACKEND=auto
NEXORA_SMART_MINI_ENABLED=true
NEXORA_SMART_MINI_NAME=Nexora Smart Mini
OPENAI_COMPATIBLE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=
NEXORA_MAX_AGENT_STEPS=20
NEXORA_MAX_CONCURRENT_TASKS=2
